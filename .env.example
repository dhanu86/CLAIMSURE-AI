# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database URL (SQLite default for out-of-the-box local run; PostgreSQL supported)
DATABASE_URL=sqlite:///./claimsure.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/claimsure_db

# Security & JWT
JWT_SECRET_KEY=claimsure-ai-super-secret-key-change-in-production-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & Document Intelligence Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/embedding-001

# Storage
STORAGE_DIR=./storage

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
